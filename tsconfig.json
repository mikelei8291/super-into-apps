{
    "compilerOptions": {
        "module": "nodenext",
        "moduleDetection": "force",
        "moduleResolution": "nodenext",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "sourceMap": false,
        "strict": true,
        "skipLibCheck": true,
        "target": "es2023",
        "lib": ["ES2023"]
    },
    "include": [
        "ambient.d.ts",
        "src/**/*.ts"
    ]
}
